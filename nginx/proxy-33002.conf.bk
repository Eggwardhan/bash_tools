            location /vibe/api/ {
                proxy_pass http://127.0.0.1:37853/api/;
                proxy_http_version 1.1;            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_buffering off;
        }
    
        location /vibe/ {
            alias /mnt/cache/zhaohui_share/codes/vibe-kanban/frontend/dist/;
            try_files $uri $uri/ /vibe/index.html;
        }    
