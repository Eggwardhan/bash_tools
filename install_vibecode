#!/bin/bash

# CodeX & ClaudeCode 一键安装脚本 for Linux & macOS (中国镜像优化版)
# 注意：每个函数即使失败也会继续执行后续步骤

echo "开始安装 CodeX 和 ClaudeCode..."
echo "使用中国镜像源优化下载速度..."

# 检测操作系统类型
detect_os() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        OS_TYPE="macos"
        echo "检测到操作系统: macOS"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        OS_TYPE="linux"
        echo "检测到操作系统: Linux"
    else
        echo "错误: 不支持的操作系统 ($OSTYPE)"
        exit 1
    fi
}

# 配置中国镜像源
setup_china_mirrors() {
    # 配置 npm 淘宝镜像
    npm config set registry https://registry.npmmirror.com    
    echo "✓ npm 镜像已配置为淘宝镜像"
}

# 安装最新版 Node.js
install_latest_node() {
    echo "正在安装最新版 Node.js..."

    if [ "$OS_TYPE" == "linux" ]; then
        # 清理可能的旧版本
        sudo apt-get remove -y nodejs npm
        sudo apt-get autoremove -y

        # 安装 curl 和必要的工具
        sudo apt-get update
        sudo apt-get install -y curl git build-essential

        # 使用 NodeSource 安装最新 LTS 版本
        curl -fsSL https://deb.nodesource.com/setup_lts.x | sudo -E bash -
        sudo apt-get install -y nodejs
    elif [ "$OS_TYPE" == "macos" ]; then
        # 检查 Homebrew 是否安装
        if ! command -v brew &> /dev/null; then
            echo "正在安装 Homebrew..."
            /bin/bash -c "$(curl -fsSL https://gitee.com/ineo6/homebrew-install/raw/master/install.sh)"
            # 配置 Homebrew 环境变量
            echo 'eval "$(/opt/homebrew/bin/brew shellenv)"' >> ~/.zshrc
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi

        # Homebrew 会自动处理 Node.js 的升级和替换，无需手动卸载旧版本
        echo "使用 Homebrew 安装/升级 Node.js..."
        brew update
        brew install node
    fi

    # 验证安装
    NODE_VERSION=$(node -v)
    NPM_VERSION=$(npm -v)
    echo "✓ Node.js $NODE_VERSION 安装完成"
    echo "✓ npm $NPM_VERSION 安装完成"
}

# 安装 CodeX
install_codex() {
    echo "开始安装 CodeX..."
    
    # 使用淘宝镜像安装 CodeX CLI
    if npm install -g @openai/codex --registry=https://registry.npmmirror.com 2>/dev/null; then
        echo "✓ CodeX CLI 安装成功"
    else
        echo "⚠️  CodeX CLI 已存在或安装失败，继续配置..."
    fi

    # 创建配置目录
    CONFIG_DIR="$HOME/.codex"
    mkdir -p "$CONFIG_DIR"

    # 创建 config.toml 配置文件
    CONFIG_FILE="$CONFIG_DIR/config.toml"
    cat > "$CONFIG_FILE" <<'EOF'
ask_for_approval = "never"
sandbox = "workspace-write"
skip_git_repo_check = true
disable_response_storage = true
model_provider = "crs"
model = "gpt-5.4"
model_reasoning_effort = "xhigh"
preferred_auth_method = "apikey"

[model_providers.crs]
name = "crs"
base_url = "https://claude.doffe.cn/openai"
wire_api = "responses"
requires_openai_auth = true
env_key = "OPENAI_API_KEY"
EOF
    echo "✓ config.toml 已创建"

    # 提示用户输入 API Key
    echo ""
    echo "请输入 OPENAI_API_KEY:"
    read -r OPENAI_KEY

    # 创建 auth.json 配置文件
    AUTH_FILE="$CONFIG_DIR/auth.json"
    cat > "$AUTH_FILE" <<EOF
{
  "OPENAI_API_KEY": "$OPENAI_KEY"
}
EOF
    echo "✓ auth.json 已创建"
    echo "✓ CodeX 安装完成"
}
# 安装 Google Gemini CLI 工具
install_gemini() {
    echo "开始安装 Google Gemini 相关工具..."

    # 安装 Google 官方的 Gemini CLI 工具
    if npm view @google/gemini-cli 2>/dev/null; then
        echo "安装 Google 官方 Gemini CLI 工具..."
        if npm install -g @google/gemini-cli --registry=https://registry.npmmirror.com 2>/dev/null; then
            echo "✓ @google/gemini-cli 安装完成"
        else
            echo "⚠️  @google/gemini-cli 安装失败，继续..."
        fi
    else
        echo "⚠️  @google/gemini-cli 包未找到"
    fi

    # 安装 Google Generative AI SDK
    if npm view @google/generative-ai 2>/dev/null; then
        echo "安装 Google Generative AI npm 包..."
        if npm install -g @google/generative-ai --registry=https://registry.npmmirror.com 2>/dev/null; then
            echo "✓ @google/generative-ai 安装完成"
        else
            echo "⚠️  @google/generative-ai 安装失败，继续..."
        fi
    else
        echo "⚠️  @google/generative-ai 包未找到"
    fi

    # 同时安装 Python SDK（可选，但推荐）
    echo "检查并安装 Python 相关包..."
    if command -v pip &> /dev/null; then
        if pip install google-generativeai --index-url https://pypi.tuna.tsinghua.edu.cn/simple 2>/dev/null; then
            echo "✓ google-generativeai Python 包安装完成"
        else
            echo "⚠️  google-generativeai Python 包安装失败，继续..."
        fi
    elif command -v uv &> /dev/null; then
        if uv pip install google-generativeai --index-url https://pypi.tuna.tsinghua.edu.cn/simple 2>/dev/null; then
            echo "✓ google-generativeai Python 包安装完成"
        else
            echo "⚠️  google-generativeai Python 包安装失败，继续..."
        fi
    fi

    echo "✓ Google Gemini 相关工具安装完成"
}

# 配置环境变量
setup_environment_variables() {
    # 根据操作系统确定配置文件
    if [ "$OS_TYPE" == "linux" ]; then
        local config_file="$HOME/.bashrc"
    elif [ "$OS_TYPE" == "macos" ]; then
        # macOS 优先使用 .zshrc (默认 Shell)，如果不存在则检查 .bash_profile
        if [ -f "$HOME/.zshrc" ]; then
            local config_file="$HOME/.zshrc"
        elif [ -f "$HOME/.bash_profile" ]; then
            local config_file="$HOME/.bash_profile"
        else
            local config_file="$HOME/.bashrc"  # 备用
        fi
    fi

    local env_marker="# AI Tools Environment Variables"

    echo "配置环境变量到 $config_file ..."

    # 检查是否已经配置过
    if grep -q "$env_marker" "$config_file" 2>/dev/null; then
        echo "✓ 环境变量已存在，跳过配置"
        return
    fi

    # 添加环境变量配置
    cat >> "$config_file" << EOF

$env_marker
# OpenAI CodeX 配置
export OPENAI_API_KEY=""
export OPENAI_BASE_URL="https://claude.doffe.cn/openai"
# Anthropic ClaudeCode 配置
export ANTHROPIC_BASE_URL="https://claude.doffe.cn/api"
export ANTHROPIC_AUTH_TOKEN="cr_c024c04500b6e134f818dd57e92a61e61cf32adb0c8e72b77abfeebc45c4be63"
# Google Gemini 配置
export GOOGLE_API_KEY=""

EOF

    echo "✓ 环境变量已添加到 $config_file"
    echo "⚠️  请记得编辑 $config_file 并填入真实的 API Keys"
}


# 配置 ClaudeCode 完成引导状态
configure_claude_onboarding() {
    echo "配置 ClaudeCode 引导状态..."

    CLAUDE_CONFIG="$HOME/.claude.json"

    # 检查文件是否存在
    if [ -f "$CLAUDE_CONFIG" ]; then
        # 使用 jq 添加或更新 hasCompletedOnboarding 字段
        if command -v jq &> /dev/null; then
            # 使用 jq 修改
            jq '. + {"hasCompletedOnboarding": true}' "$CLAUDE_CONFIG" > "$CLAUDE_CONFIG.tmp"
            mv "$CLAUDE_CONFIG.tmp" "$CLAUDE_CONFIG"
            echo "✓ 使用 jq 更新 ~/.claude.json"
        else
            # 使用 Node.js 修改
            node -e "
                const fs = require('fs');
                const config = JSON.parse(fs.readFileSync('$CLAUDE_CONFIG', 'utf8'));
                config.hasCompletedOnboarding = true;
                fs.writeFileSync('$CLAUDE_CONFIG', JSON.stringify(config, null, 2));
            "
            echo "✓ 使用 Node.js 更新 ~/.claude.json"
        fi
    else
        # 创建新文件
        cat > "$CLAUDE_CONFIG" << EOF
{
  "hasCompletedOnboarding": true
}
EOF
        echo "✓ ~/.claude.json 已创建并配置"
    fi
}

# 安装 ClaudeCode
install_claudecode() {
    echo "开始安装 ClaudeCode..."

    # 使用淘宝镜像安装 ClaudeCode
    # 注意：ClaudeCode 可能有不同的包名，这里假设是 @anthropic-ai/claudecode
    # 如果包名不对，请根据实际情况调整
    if npm install -g @anthropic-ai/claude-code 2>/dev/null; then
        echo "✓ ClaudeCode CLI 安装成功"
    else
        echo "⚠️  ClaudeCode CLI 已存在或安装失败，继续配置..."
    fi

    # 配置引导状态
    configure_claude_onboarding

    echo "✓ ClaudeCode 安装完成"
}

# 安装 pnpm (可选，但推荐用于更好的包管理)
install_pnpm() {
    echo "安装 pnpm (快速包管理器)..."
    if npm install -g pnpm --registry=https://registry.npmmirror.com 2>/dev/null; then
        pnpm config set registry https://registry.npmmirror.com 2>/dev/null || true
        echo "✓ pnpm 安装完成"
    else
        echo "⚠️  pnpm 已存在或安装失败，继续..."
    fi
}

# 主安装流程
main() {
    echo "========================================"
    echo "CodeX & ClaudeCode 一键安装脚本"
    echo "优化中国用户使用体验"
    echo "========================================"

    # 检测操作系统
    detect_os

    # 配置镜像源

    # 检查 Node.js
    if command -v node &> /dev/null; then
        CURRENT_NODE_VERSION=$(node -v)
        echo "当前 Node.js 版本: $CURRENT_NODE_VERSION"
        read -p "是否重新安装最新版 Node.js? (y/N): " reinstall_node
        if [[ $reinstall_node =~ ^[Yy]$ ]]; then
            install_latest_node
        else
            echo "使用现有 Node.js 版本"
        fi
    else
        install_latest_node
    fi
    setup_china_mirrors
    # 安装 pnpm
    install_pnpm

    # 安装 CodeX
    install_codex

    # 安装 ClaudeCode
    install_claudecode

    # 安装 Google Gemini
    install_gemini

    setup_environment_variables
    # 显示安装总结
    echo ""
    echo "========================================"
    echo "🎉 安装完成！"
    echo "========================================"
}

# 运行主函数
main "$@"

